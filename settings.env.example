# Copy to settings.env and edit. Restart the ticker after changes:
#   sudo systemctl restart crypto-ticker

# Coins to show, in order. A plain ticker picks the largest coin with that symbol.
# To pin an exact coin, add its CoinGecko id after a colon, e.g. ada:cardano
SYMBOLS=btc:bitcoin,eth:ethereum,ada:cardano,link:chainlink,hbar:hedera-hashgraph,pepe:pepe,doge:dogecoin,snek:snek,sol:solana,night:midnight-3

# Price currency: usd, eur, gbp, jpy, ...
CURRENCY=usd

# Optional free CoinGecko "Demo" API key (coingecko.com/en/api). Works without one,
# but a key gives steadier rate limits.
COINGECKO_API_KEY=

# How often to refresh prices: auto, or seconds (minimum 60). Each refresh is one API call.
# auto = as often as once a minute while staying under MONTHLY_CALL_BUDGET
# (CoinGecko's free Demo plan allows 10,000 calls a month).
REFRESH_RATE=auto
MONTHLY_CALL_BUDGET=10000
# Seconds each coin stays on screen
SLEEP=5
# Between screens: scroll (old moves up, new rolls in from the bottom), slide (sideways) or none
TRANSITION=scroll
# classic = icon + mini chart;  chart = full-screen chart behind the text;  mix = alternate
LAYOUT=classic
# The chart layout's chart: line (filled area) or candles (16 candlesticks over the week)
CHART_STYLE=line
# Favorite coins get a big-picture screen before their price (★ on the phone page)
FEATURED=snek
# Focus: on = the coin rotation shows only the starred (FEATURED) coins; clock,
# Fear & Greed and indices keep running. If no coin is starred, all coins show.
FOCUS=off
# List view: off = one coin per screen; 4 = pages of 4 coins (price and % change; what the
# phone page's switch turns on); 5 = pages of 5 coins (smaller font, ▲/▼ + price).
# Starred coins keep their big screens.
LIST_VIEW=off
# Seconds each list page stays on screen
LIST_PAGE_SECONDS=6

# Panel brightness 1-100, and optional night dimming (24h clock, e.g. 22-7 = 10pm to 7am)
BRIGHTNESS=70
DIM_HOURS=22-7
DIM_BRIGHTNESS=15

# Download coin icons automatically. Put your own PNG at icons/<symbol>.png to override one.
DOWNLOAD_ICONS=true

# Screens at the start of each cycle, in order (coins always last):
#   clock, weather (big temperature, high/low, next 12 hours), feargreed (crypto Fear & Greed
#   from alternative.me), indices, metals (gold, silver, WTI oil), news (scrolling headlines), sports (scores),
#   arcade (short maze-chase animations: chomper, ghosts, cherries; off unless listed here),
#   watchlist (stocks, ETFs, mutual funds, futures from Yahoo; see WATCHLIST below),
#   odds (prediction-market odds from Polymarket / Kalshi links; see ODDS_MARKETS below),
#   flights (flights you're tracking, then planes in the air near the weather location; see FLIGHTS_* below)
SCREENS=clock,feargreed,indices,coins
# Arcade animation scenes per cycle (1-6, about 5 seconds each; they take turns)
ARCADE_PER_CYCLE=1
# Watchlist: Yahoo Finance symbols, comma separated, up to 20. Optional short panel name
# (1-6 letters, digits or & . -) after a colon. Futures end in =F, indices start with ^.
# Example: AAPL,SPY,VTSAX,ES=F:S&P,CL=F:WTI,GC=F:GOLD,^VIX
WATCHLIST=
# Minutes between watchlist refreshes: 5, 10, 15 or 30 (30 automatically while every market is closed)
WATCHLIST_REFRESH=10
# Watchlist symbols per cycle (1-20; they take turns across cycles)
WATCHLIST_PER_CYCLE=5
# Betting lines (display only): after each upcoming game, a second frame with each team's
# spread (moneyline for baseball and hockey) and the over/under, from ESPN. on or off.
SPORTS_ODDS=off
# Prediction markets for the "odds" screen: Polymarket event links or Kalshi market links,
# comma separated, up to 10 (stored as poly:<event> / kalshi:<TICKER>). Display only.
ODDS_MARKETS=
# Prediction markets per cycle (1-10; they take turns)
ODDS_PER_CYCLE=3
# Planes overhead: miles around WEATHER_LAT/WEATHER_LON (3, 5, 10, 15 or 25), and how many of
# the closest to show each cycle (1-5). Checked every 30 s, only while "flights" is in SCREENS.
FLIGHTS_RADIUS=10
FLIGHTS_PER_CYCLE=3
# Planes overhead on or off (off = only the tracked flights below)
FLIGHTS_OVERHEAD=on
# Flights to follow, comma separated, up to 4: flight numbers (AA1234, UA512) or ICAO callsigns
# (ENY3456). Each shows its route, where it is, an estimated arrival time, then LANDED.
FLIGHTS_TRACK=
# coingecko = tokenized S&P 500 / Nasdaq-100 funds (no extra calls); yahoo = real index values incl. Dow
INDICES_SOURCE=coingecko
# percent = show the % change; both = flip to the $ / point change halfway through.
# With coingecko, S&P and Nasdaq are tokenized-fund prices ($ per share), not index points.
INDICES_VIEW=percent
# Clock time zone (blank = the Pi's setting)
TIMEZONE=America/Chicago
# Outdoor temperature and weather icon on the clock (Open-Meteo, free, no key).
# Easiest: set your ZIP code on the phone page. Default: Edinburg, TX
WEATHER_PLACE=Edinburg, Texas, US
WEATHER_LAT=26.3017
WEATHER_LON=-98.1633
TEMP_UNIT=F

# --- Panel hardware ---
LED_ROWS=32
LED_COLS=64
LED_CHAIN=1
# adafruit-hat, or adafruit-hat-pwm if you soldered the bonnet's PWM jumper
LED_GPIO_MAPPING=adafruit-hat
# Pi Zero: 0-1.  Pi 3: 2.  Pi 4/5: 4. Raise it if the display flickers or shows garbage.
LED_SLOWDOWN_GPIO=1

# --- News screen ---
# RSS or Atom feeds, comma separated (max 8). Checked every 15 minutes.
NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://feeds.bbci.co.uk/news/business/rss.xml
# Crypto news (the feeds above) and general news (top stories, politics, business, world),
# each on/off. General defaults: NPR top stories, politics, business, and BBC World.
NEWS_CRYPTO=on
NEWS_GENERAL=off
NEWS_GENERAL_FEEDS=https://feeds.npr.org/1001/rss.xml,https://feeds.npr.org/1014/rss.xml,https://feeds.npr.org/1006/rss.xml,https://feeds.bbci.co.uk/news/world/rss.xml
# Politics (off by default): AP (via its Flipboard), Reuters (via Google News), NPR, Politico,
# MS NOW and Fox News. AP and Reuters no longer publish RSS feeds of their own.
NEWS_POLITICS=off
NEWS_POLITICS_FEEDS=https://flipboard.com/@associatedpress/politics-h8vn14lnz.rss,https://news.google.com/rss/search?q=when:24h+site:reuters.com/world/us&hl=en-US&gl=US&ceid=US:en,https://feeds.npr.org/1014/rss.xml,https://rss.politico.com/politics-news.xml,https://www.ms.now/category/politics/feed,https://moxie.foxnews.com/google-publisher/politics.xml
# Headlines per cycle (1-10) and scroll speed: slow, normal or fast
NEWS_PER_CYCLE=3
NEWS_SPEED=normal

# --- Videos screen (new YouTube uploads; add "videos" to SCREENS to turn it on) ---
# Channels as ids (UC...) or @handles, comma separated (max 10). Easiest: paste channel
# links on the phone page, which converts them. Checked every 30 minutes.
VIDEOS_CHANNELS=
# Videos per cycle (1-10), only uploads from the last N days (1-30), skip Shorts (on/off).
# Titles scroll at NEWS_SPEED.
VIDEOS_PER_CYCLE=3
VIDEOS_MAX_AGE_DAYS=3
VIDEOS_SKIP_SHORTS=on

# --- Sports screen (ESPN scores; sports out of season are skipped) ---
# Per league: on/off, top teams to follow (college: AP 0/10/25; pro: 0/4/8/12/16 by record),
# and favorites as ESPN team id:ABBR pairs (easiest to pick on the phone page).
SPORTS_NFL=on
SPORTS_NFL_TOP=8
SPORTS_NFL_FAVORITES=
SPORTS_NCAAF=on
SPORTS_NCAAF_TOP=25
SPORTS_NCAAF_FAVORITES=
SPORTS_NBA=on
SPORTS_NBA_TOP=8
SPORTS_NBA_FAVORITES=
SPORTS_NCAAM=on
SPORTS_NCAAM_TOP=25
SPORTS_NCAAM_FAVORITES=
SPORTS_MLB=on
SPORTS_MLB_TOP=8
SPORTS_MLB_FAVORITES=
SPORTS_NHL=off
SPORTS_NHL_TOP=8
SPORTS_NHL_FAVORITES=

# --- Logging (rotating file; the SD card is small) ---
# LOG_LEVEL=INFO
# LOG_FILE=logs/ticker.log     (blank = no log file, console/journal only)
# LOG_MAX_KB=512               size of one file before it rotates
# LOG_BACKUPS=3                rotated files kept (total at most ~2 MB)

# --- Update button (phone page) ---
# Pulls over SSH with a deploy key; install.sh --deploy-key creates it. Defaults shown:
# UPDATE_REMOTE=git@github.com:<owner>/crypto-ticker.git   (SSH form of origin)
# UPDATE_SSH_KEY=~/.ssh/crypto-ticker-deploy

# --- Phone settings page ---
# Open http://<pi-name>.local:8080 on your phone (same Wi-Fi) to edit coins and display settings.
WEB_ENABLED=true
WEB_PORT=8080
# PIN for the settings page (install.sh asks for one). Leave blank for no PIN.
WEB_PIN=

# --- Portfolio (shown after the coins) ---
# Every start resets PORTFOLIO=off and PORTFOLIO_PRIVATE=on: the screen is hidden and,
# once shown, private (no dollar amounts) until you change it on the phone page.
PORTFOLIO=off
PORTFOLIO_PRIVATE=on
# Private mode shows the 24-hour % (24h) or the total % since your cost basis (total)
PORTFOLIO_PCT=24h
# symbol:quantity[:total dollars paid], for coins on your coin list. Stays on the Pi.
# Easiest from the phone page (Portfolio section). Example: btc:0.5:30000,ada:12000:4000
PORTFOLIO_HOLDINGS=
